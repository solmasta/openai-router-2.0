#!/data/data/com.termux/files/usr/bin/bash

ROOT="$(cd "$(dirname "$0")" && pwd)"

case "$1" in

start)
    "$ROOT/router-control.sh" start
    ;;

stop)
    "$ROOT/router-control.sh" stop
    ;;

restart)
    "$ROOT/router-control.sh" restart
    ;;

doctor)
    "$ROOT/router-doctor.sh"
    ;;

build)
    echo "Building dashboard..."
    cd "$ROOT"
    pnpm --filter web build
    ;;

deploy)
    echo "Deploying..."
    git add .
    git commit -m "Router update" || true
    git push origin main
    ;;

logs)
    echo "Recent API logs:"
    ps -ef | grep agents.api.main | grep -v grep || echo "Router not running"
    ;;

*)
    echo "OpenAI Router Control"
    echo
    echo "Commands:"
    echo "  ./router start"
    echo "  ./router stop"
    echo "  ./router restart"
    echo "  ./router doctor"
    echo "  ./router build"
    echo "  ./router deploy"
    echo "  ./router logs"
    ;;

esac

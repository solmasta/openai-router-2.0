#!/data/data/com.termux/files/usr/bin/bash

ROOT="$(cd "$(dirname "$0")" && pwd)"
CONFIG="$ROOT/config/router.json"

case "$1" in

start)
    echo "Starting OpenAI Router..."

    pkill -f "agents.api.main" || true

    cd "$ROOT"

    python -m agents.api.main > router.log 2>&1 &

    sleep 2

    curl -s http://127.0.0.1:8000/status
    ;;

stop)
    pkill -f "agents.api.main" || true
    pkill -f "vite" || true
    echo "Stopped"
    ;;

restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;

status)
    curl -s http://127.0.0.1:8000/status
    ;;

providers)
    curl -s http://127.0.0.1:8000/router
    ;;

health)
    echo "System:"
    curl -s http://127.0.0.1:8000/status
    echo ""
    echo "Providers:"
    curl -s http://127.0.0.1:8000/router
    ;;

config)
    cat "$CONFIG"
    ;;

logs)
    tail -f "$ROOT/router.log"
    ;;

provider)
    python3 "$ROOT/providerctl.py" "${@:2}"
    ;;

*)
    echo "OpenAI Router 2.0"
    echo ""
    echo "Commands:"
    echo " router start"
    echo " router stop"
    echo " router restart"
    echo " router status"
    echo " router providers"
    echo " router health"
    echo " router config"
    echo " router logs"
    ;;

esac

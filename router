#!/data/data/com.termux/files/usr/bin/bash

ROOT="$(cd "$(dirname "$0")" && pwd)"

case "$1" in

start)
    "$ROOT/scripts/service.sh" start
    ;;

stop)
    "$ROOT/scripts/service.sh" stop
    ;;

restart)
    "$ROOT/scripts/service.sh" restart
    ;;

status)
    "$ROOT/scripts/service.sh" status
    ;;

doctor)
    "$ROOT/scripts/doctor.sh"
    ;;

update)
    "$ROOT/scripts/update.sh"
    ;;

backup)
    "$ROOT/scripts/backup.sh"
    ;;

deploy)
    "$ROOT/scripts/deploy.sh"
    ;;

config)
    python3 "$ROOT/configctl.py" "${@:2}"
    ;;

routes)
    python3 "$ROOT/routectl.py" "${@:2}"
    ;;

logs)
    tail -f "$ROOT/router.log"
    ;;

providers)
    python3 "$ROOT/providerctl.py" "${@:2}"
    ;;

keys)
    python3 "$ROOT/keyctl.py" "${@:2}"
    ;;

limits)
    python3 "$ROOT/limitctl.py" "${@:2}"
    ;;

install)
    "$ROOT/scripts/install.sh"
    ;;

*)
echo "
OpenAI Router 2.0 Control Center

Usage:

 router start
 router stop
 router restart
 router status
 router doctor
 router update
 router backup
 router logs

Provider:
 router providers list

API Keys:
 router keys list
 router keys create NAME

Limits:
 router limits usage
 router limits set USER NUMBER

Install:
 router install
"
;;

esac
